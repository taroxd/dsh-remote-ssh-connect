{
  "name": "dsh-remote-connect",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect to remote Linux hosts over SSH, provision matching DSH versions in ~/.dsh-remote-connect, sync local plugins and remote workspaces into a dedicated Remote Workspaces sidebar section, and forward ports for local browser access.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taroxd/dsh-remote-connect.git"
  },
  "homepage": "https://github.com/taroxd/dsh-remote-connect#readme",
  "bugs": {
    "url": "https://github.com/taroxd/dsh-remote-connect/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/remote-connect.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
